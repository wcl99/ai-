# Replace every placeholder before production startup.
APP_ENVIRONMENT=production
# Use an immutable registry digest for controlled production releases.
API_IMAGE=ai-security-platform-api:local
POSTGRES_PASSWORD=change-this-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Production requires HTTPS termination and secure cookies.
# For local HTTP only, explicitly set COOKIE_SECURE=false and
# APP_ENVIRONMENT=development in the local .env file.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
ENGINE_MODE=mock
ENGINE_RETRY_LIMIT=2
XIAOYI_BASE_URL=http://host.docker.internal:49980
XIAOYI_TOKEN=
XIAOYI_ORG_ID=
XIAOYI_USER_ID=
PIP_INDEX_URL=https://pypi.org/simple
